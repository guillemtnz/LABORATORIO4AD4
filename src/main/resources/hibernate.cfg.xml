<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE hibernate-configuration PUBLIC
        "-//Hibernate/Hibernate Configuration DTD 3.0//EN"
        "http://www.hibernate.org/dtd/hibernate-configuration-3.0.dtd">

<hibernate-configuration>
    <session-factory>
        <!-- Conexión al fichero local holonet.db. foreign_keys=true activa las FKs, que en SQLite vienen desactivadas -->
        <property name="connection.driver_class">org.sqlite.JDBC</property>
        <property name="connection.url">jdbc:sqlite:holonet.db?foreign_keys=true</property>

        <!-- Dialecto de SQLite (hibernate-community-dialects) -->
        <property name="dialect">org.hibernate.community.dialect.SQLiteDialect</property>

        <!-- Mostrar SQL generado -->
        <property name="show_sql">true</property>
        <property name="format_sql">true</property>

        <!-- Las tablas las crea el script; Hibernate solo comprueba que coinciden con las entidades -->
        <property name="hbm2ddl.auto">validate</property>

        <!-- Evito que Hibernate cree tablas auxiliares HT_/HTE_ que no uso -->
        <property name="hibernate.query.mutation_strategy.persistent.create_tables">false</property>
        <property name="hibernate.query.mutation_strategy.global_temporary.create_tables">false</property>
        <property name="hibernate.query.insert_strategy.persistent.create_tables">false</property>
        <property name="hibernate.query.insert_strategy.global_temporary.create_tables">false</property>

        <!-- Entidades -->
        <mapping class="ut4.sqlite.modelo.Planeta"/>
        <mapping class="ut4.sqlite.modelo.Nave"/>
        <mapping class="ut4.sqlite.modelo.CazaLigero"/>
        <mapping class="ut4.sqlite.modelo.DestructorEstelar"/>
    </session-factory>
</hibernate-configuration>
